<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/lockLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="72sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Phone locked"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Your parent locked this phone. It will unlock when your parent unlocks it. You can still call and open Contacts."
        android:textColor="#C9C9CF"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="CELL HOME Kids"
        android:textColor="#E31B23"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- Shown only when the parent allowed calls: let the child reach Phone + Contacts. -->
    <LinearLayout
        android:id="@+id/callRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/callBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#E31B23"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="📞 Call"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/contactsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#333333"
            android:text="👤 Contacts"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Hidden parent unlock: enter the PIN. -->
    <Button
        android:id="@+id/parentUnlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@android:color/transparent"
        android:text="Parent unlock"
        android:textColor="#55FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
